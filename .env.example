# ========================================
# CONFIGURATION DROGUA CENTER
# ========================================
# Copiez ce fichier en .env et remplissez les valeurs

# ==================== TELEGRAM ====================
TELEGRAM_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id
SUPPORT_CHAT_ID=your_support_chat_id
DRIVER_MILLAU_ID=0
DRIVER_EXTERIEUR_ID=0

# Secret pour authentifier les webhooks Telegram (persistant entre redémarrages)
# Générez avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ==================== CANAUX TELEGRAM ====================
TELEGRAM_CHANNEL_ID=your_channel_id
TELEGRAM_PHOTO_CHANNEL_ID=your_photo_channel_id
TELEGRAM_SECOURS_CHANNEL_ID=your_secours_channel_id

# ==================== ADMIN ====================
ADMIN_PASS=change_this_to_a_strong_password

# ==================== APPLICATION ====================
WEBAPP_URL=https://your-app-url.up.railway.app
PORT=3000

# ==================== BASE DE DONNÉES ====================
# IMPORTANT: Sur Railway, utiliser un Volume monté sur /data
# pour persister les données entre les redéploiements
DATABASE_PATH=/data/boutique.db

# Cle Mapbox pour autocompletion adresses
MAPBOX_KEY=your_mapbox_key_here
